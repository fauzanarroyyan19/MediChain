
PORT=5000
NODE_ENV=development

DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=

DB_NAME=medichain_db

FRONTEND_URL=http://localhost:5173

# SMTP for password reset email (use an app password, not your mailbox password)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-smtp-user@example.com
SMTP_PASS=replace-with-smtp-app-password
SMTP_FROM=MediChain <no-reply@example.com>
